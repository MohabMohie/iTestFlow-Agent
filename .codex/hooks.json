{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "py -3 .chaos-engine/hooks/guard.py",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Bash|PowerShell|shell_command"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "py -3 .chaos-engine/hooks/guard.py",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Bash|PowerShell|shell_command"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "py -3 .chaos-engine/hooks/guard.py",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "py -3 .chaos-engine/hooks/guard.py",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "py -3 .chaos-engine/hooks/guard.py",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "py -3 .chaos-engine/hooks/guard.py",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  }
}
